<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Umbraco Community Automate Mastodon</Title>
    <Description>Mastodon connection type and action for Umbraco Automate. Lets you post statuses to any Mastodon instance as part of an automation workflow.</Description>
    <PackageTags>umbraco automate automation mastodon fediverse umbraco-marketplace</PackageTags>
    <!-- Serves wwwroot/ as static web assets under this path, which is where
         MastodonPackageManifestReader points the icons extension's js. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>App_Plugins/UmbracoCommunityAutomateMastodon</StaticWebAssetBasePath>
    <PackageIcon>community-automate-128.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Automate.Core" />
    <PackageReference Include="Umbraco.Cms.Core" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <!-- Don't pull this out again! I removed it thinking it was a hangover from my own
         repo, but it's what actually versions the package. release.yml packs straight off
         the mastodon-v* tag and never passes a version, so with MinVer gone everything
         ships as 1.0.0 and NuGet quietly skips it as a duplicate. -->
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <!-- Ships as the NuGet package README (see PackageReadmeFile in Directory.Build.props) and
       drives the Umbraco Marketplace listing's description, since this repo relies on the
       auto-sourced NuGet metadata rather than a hosted umbraco-marketplace.json override. -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <!-- PackageIcon only names the file inside the .nupkg; the file still has to be packed
         into it, or pack fails with NU5046. -->
    <None Include="community-automate-128.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
