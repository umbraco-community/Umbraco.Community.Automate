{
  "//": "Copy this file to appsettings.Local.json (git-ignored, so it can never be committed) and replace the values for the services you want to try against live accounts. Values you leave as they are behave like the placeholders in appsettings.Development.json.",
  "Umbraco": {
    "Automate": {
      "Providers": {
        "GoogleSheets": {
          "ClientId": "your-google-oauth-client-id",
          "ClientSecret": "your-google-oauth-client-secret"
        }
      },
      "Variables": {
        "Mastodon": { "InstanceUrl": "https://mastodon.social" }
      },
      "Secrets": {
        "DevTo": { "ApiKey": "your-dev-to-api-key" },
        "Mastodon": { "AccessToken": "your-mastodon-access-token" },
        "Pushover": { "ApiToken": "your-pushover-app-token", "UserKey": "your-pushover-user-key" },
        "Skoda": { "ApiKey": "your-skoda-api-key", "Spin": "your-s-pin" },
        "WeatherApi": { "ApiKey": "your-weatherapi-key" }
      }
    }
  }
}
