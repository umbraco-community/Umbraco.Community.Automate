<?xml version="1.0" encoding="utf-8"?>
<Automation Key="830bb232-6cd7-473c-954a-48a310b2dd9e" Alias="testGoogleSheets" Level="0">
  <Info>
    <Name>Test: Google Sheets</Name>
    <Description>Starts when the Google Sheets page under "Automate tests" is published, tests the googleSheets connection, and tells you on screen whether it works. Add the Google Sheets actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "f1fb3f25-2345-45f2-a4b3-c15f7394f5f7"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="04b3598a-b769-4a87-ab10-107f92a39ddf" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The googleSheets connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "Google Sheets test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="bcd754a8-198d-4eda-84b7-555fec3d87ae" ActionAlias="umbracoAutomate.if">
      <Name>Did it connect?</Name>
      <Alias>didItConnect</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "conditions": {
    "Groups": [
      {
        "Conditions": [
          {
            "LeftOperand": "${ steps.testConnection.connected }",
            "Operator": "Equals",
            "RightOperand": "true"
          }
        ]
      }
    ]
  }
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="d9ca25bc-5801-4e77-9b06-724772944ccc" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "Google Sheets is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="e7fe3803-595e-4969-b8ca-4219ddd1e27b" ActionAlias="community.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "googleSheets"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="e7fe3803-595e-4969-b8ca-4219ddd1e27b">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="bcd754a8-198d-4eda-84b7-555fec3d87ae" Target="04b3598a-b769-4a87-ab10-107f92a39ddf">
      <SourceHandle>false</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>false</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="bcd754a8-198d-4eda-84b7-555fec3d87ae" Target="d9ca25bc-5801-4e77-9b06-724772944ccc">
      <SourceHandle>true</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>true</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="e7fe3803-595e-4969-b8ca-4219ddd1e27b" Target="bcd754a8-198d-4eda-84b7-555fec3d87ae">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":180,"y":20,"zoom":0.9},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>