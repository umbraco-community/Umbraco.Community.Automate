<?xml version="1.0" encoding="utf-8"?>
<Automation Key="7105d825-328b-42f6-9321-a2a81b387025" Alias="testExamplesSimple" Level="0">
  <Info>
    <Name>Test: Simple Example (httpbin.org)</Name>
    <Description>Starts when the Simple Example (httpbin.org) page under "Automate tests" is published, tests the examples-simple connection, and tells you on screen whether it works. Add the Simple Example (httpbin.org) actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "6f2e516c-369a-4fab-b8fa-42e358f4b434"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="01d18982-e498-4ad0-bec0-89b67320aae2" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The examples-simple connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "Simple Example (httpbin.org) test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="16cf278c-bd64-46da-bf2d-7a70f0bad15f" ActionAlias="umbracoAutomate.if">
      <Name>Did it connect?</Name>
      <Alias>didItConnect</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "conditions": {
    "Groups": [
      {
        "Conditions": [
          {
            "LeftOperand": "${ steps.testConnection.connected }",
            "Operator": "Equals",
            "RightOperand": "true"
          }
        ]
      }
    ]
  }
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="579235a5-5641-46ed-b58b-4808cc31566c" ActionAlias="community.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "examples-simple"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="a77e3589-46e4-4354-a880-d59cf36c8d34" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "Simple Example (httpbin.org) is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="579235a5-5641-46ed-b58b-4808cc31566c">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="16cf278c-bd64-46da-bf2d-7a70f0bad15f" Target="01d18982-e498-4ad0-bec0-89b67320aae2">
      <SourceHandle>false</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>false</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="16cf278c-bd64-46da-bf2d-7a70f0bad15f" Target="a77e3589-46e4-4354-a880-d59cf36c8d34">
      <SourceHandle>true</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>true</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="579235a5-5641-46ed-b58b-4808cc31566c" Target="16cf278c-bd64-46da-bf2d-7a70f0bad15f">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":180,"y":20,"zoom":0.9},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>