<?xml version="1.0" encoding="utf-8"?>
<Automation Key="333d15e4-8995-495c-807f-777c8041a504" Alias="testSkoda" Level="0">
  <Info>
    <Name>Test: Škoda</Name>
    <Description>Starts when the Škoda page under "Automate tests" is published, tests the skoda connection, and tells you on screen whether it works. Add the Škoda actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "b14778ac-2a22-4038-8e45-0aad29ac2131"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="0ddf6c81-866c-4480-a129-34b2861ab444" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The skoda connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "\u0160koda test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="37c5005a-d973-4996-8353-d7f8b0457093" ActionAlias="umbracoAutomate.if">
      <Name>Did it connect?</Name>
      <Alias>didItConnect</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "conditions": {
    "Groups": [
      {
        "Conditions": [
          {
            "LeftOperand": "${ steps.testConnection.connected }",
            "Operator": "Equals",
            "RightOperand": "true"
          }
        ]
      }
    ]
  }
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="49317d64-591f-4de8-b78e-68e4f2657767" ActionAlias="community.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "skoda"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="b4ab7471-82a6-4ce1-ab4d-69d4a7255cdc" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "\u0160koda is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="49317d64-591f-4de8-b78e-68e4f2657767">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="37c5005a-d973-4996-8353-d7f8b0457093" Target="0ddf6c81-866c-4480-a129-34b2861ab444">
      <SourceHandle>false</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>false</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="37c5005a-d973-4996-8353-d7f8b0457093" Target="b4ab7471-82a6-4ce1-ab4d-69d4a7255cdc">
      <SourceHandle>true</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>true</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="49317d64-591f-4de8-b78e-68e4f2657767" Target="37c5005a-d973-4996-8353-d7f8b0457093">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":180,"y":20,"zoom":0.9},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>