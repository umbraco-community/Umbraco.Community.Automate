<?xml version="1.0" encoding="utf-8"?>
<Automation Key="e2737e6f-1f04-4885-a8a8-193d215b0887" Alias="testWeatherApi" Level="0">
  <Info>
    <Name>Test: WeatherAPI.com</Name>
    <Description>Starts when the WeatherAPI.com page under "Automate tests" is published, tests the weatherApi connection, and tells you on screen whether it works. Add the WeatherAPI.com actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "be0d93b6-78e5-44b4-923d-c0c52e39024f"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="29085b2b-8e44-4534-9e50-1341252ebbc8" ActionAlias="umbracoAutomate.if">
      <Name>Did it connect?</Name>
      <Alias>didItConnect</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "conditions": {
    "Groups": [
      {
        "Conditions": [
          {
            "LeftOperand": "${ steps.testConnection.connected }",
            "Operator": "Equals",
            "RightOperand": "true"
          }
        ]
      }
    ]
  }
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="72dca2c5-b1c1-4241-b3e9-6e68678af766" ActionAlias="community.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "weatherApi"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="ea408f5e-dc59-4537-a413-01856f65fe99" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The weatherApi connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "WeatherAPI.com test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="edb38763-c3c1-485a-a2ec-3fc1d24b942c" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "WeatherAPI.com is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="72dca2c5-b1c1-4241-b3e9-6e68678af766">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="29085b2b-8e44-4534-9e50-1341252ebbc8" Target="ea408f5e-dc59-4537-a413-01856f65fe99">
      <SourceHandle>false</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>false</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="29085b2b-8e44-4534-9e50-1341252ebbc8" Target="edb38763-c3c1-485a-a2ec-3fc1d24b942c">
      <SourceHandle>true</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>true</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="72dca2c5-b1c1-4241-b3e9-6e68678af766" Target="29085b2b-8e44-4534-9e50-1341252ebbc8">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":180,"y":20,"zoom":0.9},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>