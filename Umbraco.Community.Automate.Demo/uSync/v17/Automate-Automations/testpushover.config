<?xml version="1.0" encoding="utf-8"?>
<Automation Key="fc86e833-07e9-41c8-986f-3d04952c3e8d" Alias="testPushover" Level="0">
  <Info>
    <Name>Test: Pushover</Name>
    <Description>Starts when the Pushover page under "Automate tests" is published, tests the pushover connection, and tells you on screen whether it works. Add the Pushover actions you want to try after "Connection works".</Description>
    <Status>Published</Status>
    <Workspace Key="46291b87-e59e-41a2-9da2-7cf6f0e9f130">demo</Workspace>
  </Info>
  <Trigger Alias="umbracoAutomate.contentPublished">
    <Settings><![CDATA[{
  "contentTypes": "fd74aa8e-0aa3-463d-ac68-a21d02fe7ac5"
}]]></Settings>
  </Trigger>
  <Steps>
    <Step Id="76682cbe-5789-44f5-a75b-c7f6d5d50901" ActionAlias="umbracoAutomate.if">
      <Name>Did it connect?</Name>
      <Alias>didItConnect</Alias>
      <Connection />
      <Position X="250" Y="410" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "conditions": {
    "Groups": [
      {
        "Conditions": [
          {
            "LeftOperand": "${ steps.testConnection.connected }",
            "Operator": "Equals",
            "RightOperand": "true"
          }
        ]
      }
    ]
  }
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="8479083b-9473-4ca9-b96d-bc0d20015b8f" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection failed</Name>
      <Alias>connectionFailed</Alias>
      <Connection />
      <Position X="450" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "The pushover connection didn\u0027t work: ${ steps.testConnection.message }",
  "severity": "Danger",
  "title": "Pushover test failed"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="bb78b1ac-4fa5-447a-b06d-779663d96b08" ActionAlias="community.testConnection">
      <Name>Test Connection</Name>
      <Alias>testConnection</Alias>
      <Connection />
      <Position X="250" Y="230" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "connectionAlias": "pushover"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
    <Step Id="e21e1c28-9a14-456d-ae65-2243a002d7a9" ActionAlias="umbracoAutomate.notifyEditor">
      <Name>Connection works</Name>
      <Alias>connectionWorks</Alias>
      <Connection />
      <Position X="50" Y="590" />
      <ErrorBehavior>Terminate</ErrorBehavior>
      <RetryInterval>PT0S</RetryInterval>
      <MaxRetries>0</MaxRetries>
      <Settings><![CDATA[{
  "contentKey": "${ trigger.contentKey }",
  "message": "${ steps.testConnection.message }",
  "severity": "Positive",
  "title": "Pushover is connected"
}]]></Settings>
      <InputMappings><![CDATA[{}]]></InputMappings>
      <SensitiveFields />
    </Step>
  </Steps>
  <StepConnections>
    <StepConnection Source="00000000-0000-0000-0000-000000000000" Target="bb78b1ac-4fa5-447a-b06d-779663d96b08">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="76682cbe-5789-44f5-a75b-c7f6d5d50901" Target="8479083b-9473-4ca9-b96d-bc0d20015b8f">
      <SourceHandle>false</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>false</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="76682cbe-5789-44f5-a75b-c7f6d5d50901" Target="e21e1c28-9a14-456d-ae65-2243a002d7a9">
      <SourceHandle>true</SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome>true</Outcome>
      <Filter />
    </StepConnection>
    <StepConnection Source="bb78b1ac-4fa5-447a-b06d-779663d96b08" Target="76682cbe-5789-44f5-a75b-c7f6d5d50901">
      <SourceHandle></SourceHandle>
      <TargetHandle></TargetHandle>
      <Outcome></Outcome>
      <Filter />
    </StepConnection>
  </StepConnections>
  <ConnectionReferences />
  <CanvasState><![CDATA[{"viewport":{"x":180,"y":20,"zoom":0.9},"triggerPosition":{"x":250,"y":50}}]]></CanvasState>
</Automation>