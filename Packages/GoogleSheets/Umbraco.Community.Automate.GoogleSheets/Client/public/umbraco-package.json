{
  "$schema": "https://json.schemastore.org/umbraco-package.json",
  "id": "Umbraco.Community.Automate.GoogleSheets",
  "name": "Umbraco Community Automate Google Sheets",
  "allowTelemetry": true,
  "extensions": [
    {
      "type": "icons",
      "alias": "UmbracoCommunityAutomateGoogleSheets.Icons",
      "name": "Google Sheets Icons",
      "js": "/App_Plugins/UmbracoCommunityAutomateGoogleSheets/icons/icons.js"
    },
    {
      "name": "Umbraco Community Automate Google Sheets",
      "alias": "UmbracoCommunityAutomateGoogleSheets.Bundle",
      "type": "bundle",
      "js": "/App_Plugins/UmbracoCommunityAutomateGoogleSheets/umbraco-community-automate-google-sheets-manifests.js"
    }
  ]
}
