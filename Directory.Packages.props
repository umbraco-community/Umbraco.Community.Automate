<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <!--
    Umbraco 17 and 18 both run on net10.0, so every package ships one build for both: compiled
    against the lowest supported versions (NuGet restores the bottom of a range) and published
    with ranges that stop short of 19, which hasn't been tested.

    -p:UmbracoMajor=18 builds and tests any project against 18 instead. CI does that for every
    package (tools/test-umbraco-compat.sh). The 18 build is never packed.
  -->
  <PropertyGroup>
    <UmbracoMajor Condition="'$(UmbracoMajor)' == ''">17</UmbracoMajor>
  </PropertyGroup>

  <!-- Floors are what Umbraco.Automate.Core 17.6.0 itself requires (17.6.0 is also the first
       17.x release carrying the bindable-settings feature, umbraco/Umbraco.Automate#505). -->
  <ItemGroup Condition="'$(UmbracoMajor)' == '17'">
    <PackageVersion Include="Umbraco.Automate.Core" Version="[17.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.OpenIddict" Version="[17.0.0, 19.0.0)" />
    <!-- Cms.Api.Management 17.6.0 (see the Core floor above) needs OpenIddict.AspNetCore 7.6.0,
         which needs this at 7.6.0 too, the same floor Umbraco 18 already needs. -->
    <PackageVersion Include="OpenIddict.Client.WebIntegration" Version="[7.6.0, 8.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[17.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.Testing" Version="17.6.0" />
  </ItemGroup>

  <!-- 18.6.0 is the first 18.x release carrying the same feature (umbraco/Umbraco.Automate#443);
       its own Cms.* floor is only 18.1.0, already under the 18.2.0 floor below. -->
  <ItemGroup Condition="'$(UmbracoMajor)' == '18'">
    <PackageVersion Include="Umbraco.Automate.Core" Version="[18.6.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.OpenIddict" Version="[18.0.0, 19.0.0)" />
    <PackageVersion Include="OpenIddict.Client.WebIntegration" Version="[7.6.0, 8.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[18.2.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="[18.2.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[18.2.0, 19.0.0)" />
    <PackageVersion Include="Umbraco.Automate.Testing" Version="18.6.0" />
  </ItemGroup>

  <!-- Demo site only — it isn't multi-targeted yet, so these stay pinned to 17 regardless
       of UmbracoMajor above. Umbraco.Automate 17.6.0 pulls in Automate.Core 17.6.0, which needs
       Umbraco.Cms.* 17.6.0; 17.6.2 is its latest patch. -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Automate" Version="17.6.0" />
    <PackageVersion Include="Umbraco.Cms" Version="17.6.2" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.6.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <PackageVersion Include="ReverseMarkdown" Version="6.2.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
  </ItemGroup>

  <Target Name="CheckUmbracoMajor" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(UmbracoMajor)' != '17' And '$(UmbracoMajor)' != '18'">
    <Error Text="UmbracoMajor must be 17 or 18 (was '$(UmbracoMajor)')." />
  </Target>
</Project>